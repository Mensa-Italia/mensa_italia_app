# Copia in `.env` (gitignorato) e compila.
#
#   cp .env.example .env
#
# Nessuno di questi valori finisce mai in un file generato: le credenziali
# vengono passate al simulatore come variabili d'ambiente del processo figlio e
# all'emulatore come extra dell'intent di lancio.

# ─── Account demo usato per popolare gli screenshot ──────────────────────────
# NON scrivere valori reali qui: questo file È TRACCIATO da git.
# I valori veri vanno in `.env`, che è gitignorato.
#
# Usa un account di servizio con dati realistici ma non personali: quello che
# c'è a schermo finisce pubblicamente sugli store.
# Senza queste due variabili storekit cattura comunque, ma dall'app non
# autenticata (area pubblica).
MENSA_STOREKIT_EMAIL=
MENSA_STOREKIT_PASSWORD=

# ─── Opzionali ───────────────────────────────────────────────────────────────
# Binario Chromium usato per l'impaginazione (autodetect se assente).
# STOREKIT_CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# JDK per Gradle (autodetect: openjdk@17/@21 di Homebrew, Temurin, JBR).
# JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home

# SDK Android (autodetect: ~/Library/Android/sdk, android-commandlinetools).
# ANDROID_HOME=/opt/homebrew/share/android-commandlinetools

# ─── Upload (solo per le lane fastlane in tools/storekit/fastlane) ───────────
# App Store Connect API key
# ASC_KEY_ID=
# ASC_ISSUER_ID=
# ASC_KEY_PATH=$HOME/private_keys/AuthKey_XXXXXXXX.p8
# FASTLANE_APPLE_ID=dev@mensa.it
# FASTLANE_TEAM_ID=6WA5D3RJBU

# Google Play service account JSON
# SUPPLY_JSON_KEY=/percorso/play-service-account.json

# Traccia stack completo in caso di errore
# STOREKIT_DEBUG=1
