<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- webcredentials abilita le passkey. L'rpId in uso e' auth.mensa.it, cioe'
	     il dominio dell'istanza Zitadel: e' quello che condivide le passkey con
	     gli altri servizi che entrano via OIDC sullo stesso IdP, e l'unico con cui
	     funzionano anche quelle gia' create dalla Console (vedi il commento su
	     zauth.PasskeyRPID).
	     svc.mensa.it resta elencato di proposito: le passkey registrate prima del
	     cambio hanno quell'rpId e smetterebbero di colpo di funzionare. Si potra'
	     togliere quando non ne restera' nessuna.
	     iOS verifica l'associazione scaricando
	     https://<dominio>/.well-known/apple-app-site-association, che deve
	     contenere questo bundle sotto "webcredentials" (MensaCore/main/utilities/aasa.go;
	     su auth.mensa.it ci arriva via una route Traefik dedicata). In sviluppo,
	     prima che il file sia pubblicato, si usa il suffisso "?mode=developer" con
	     Associated Domains Development attivo sul device.
	     applinks:svc.mensa.it apre nell'app i link /links/stamp/… (QR dei
	     francobolli) e /links/event/…: l'AASA di svc.mensa.it li dichiara già
	     sotto "applinks". La vecchia app Flutter aveva questa voce; quella
	     nativa l'aveva persa. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:svc.mensa.it</string>
		<string>webcredentials:auth.mensa.it</string>
		<string>webcredentials:svc.mensa.it</string>
	</array>
	<!-- App Attest (DCAppAttestService) NON ha bisogno di entitlement qui: le build
	     distribuite (TestFlight, App Store) usano sempre l'ambiente di produzione,
	     qualunque cosa ci sia scritto ("Preparing to use the App Attest service").
	     `com.apple.developer.devicecheck.appattest-environment` serve solo a usare
	     la produzione da una build di sviluppo, e aggiungerlo obbliga a rigenerare
	     il provisioning profile della CI con la capability App Attest: senza, la
	     firma dell'archivio fallisce. Le build di sviluppo restano in sandbox, che
	     va verificata con APP_ATTEST_ENVIRONMENT=development sul server. -->
	<key>com.apple.developer.in-app-payments</key>
	<array>
		<string>merchant.it.mensa.app</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.it.mensa.app</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)group.it.mensa.app</string>
	</array>
</dict>
</plist>
